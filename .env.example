# Provider: sarvam, bhashini, or none/local
LANGUAGE_PROVIDER=sarvam

# ---------------- Database ----------------
# "auto" uses PostgreSQL when DATABASE_URL is a PostgreSQL URL;
# otherwise the local SQLite activity store is used for development.
DATABASE_BACKEND=auto
DATABASE_URL=

# ---------------- Sarvam ----------------
SARVAM_API_KEY=
SARVAM_TRANSLATION_MODEL=sarvam-translate:v1
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TRANSLATION_MODE=formal
SARVAM_NUMERALS_FORMAT=international
SARVAM_TTS_SPEAKER=shubh
# Optional comma-separated STT keyterms, max 50 terms for Saaras v4
SARVAM_KEYTERMS=PAN,Aadhaar,RC,Driving Licence,marksheet,New Delhi

# ---------------- BHASHINI ----------------
BHASHINI_API_KEY=
BHASHINI_PIPELINE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_TRANSLATION_SERVICE_ID=
BHASHINI_ASR_SERVICE_ID=
BHASHINI_TTS_SERVICE_ID=
BHASHINI_LID_SERVICE_ID=
BHASHINI_TRANSLITERATION_SERVICE_ID=


# ---------------- DigiLocker official requester OAuth ----------------
# Requires approved DigiLocker requester-partner registration and API credentials.
# Register the exact callback URL in the partner portal before configuring it here.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=https://YOUR-RENDER-SERVICE.onrender.com/digilocker/callback
DIGILOCKER_AUTHORIZE_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/authorize
DIGILOCKER_TOKEN_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/2/token
DIGILOCKER_REVOKE_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/revoke
DIGILOCKER_API_BASE_URL=https://digilocker.meripehchaan.gov.in
DIGILOCKER_SCOPES=
DIGILOCKER_USE_PKCE=true
# Maximum new document downloads in one background job; larger libraries can be fetched in another run.
DIGILOCKER_SYNC_MAX_NEW_DOCUMENTS=500
DIGILOCKER_MAX_DOCUMENT_BYTES=52428800
DIGILOCKER_ISSUED_PATH=/public/oauth2/2/files/issued
DIGILOCKER_FILES_PATH=/public/oauth2/1/files
DIGILOCKER_FILE_PATH=/public/oauth2/1/file
DIGILOCKER_PULL_ISSUERS_PATH=/public/oauth2/1/pull/issuers
DIGILOCKER_PULL_DOCTYPE_PATH=/public/oauth2/1/pull/doctype
DIGILOCKER_PULL_PARAMETERS_PATH=/public/oauth2/1/pull/parameters
DIGILOCKER_PULL_DOCUMENT_PATH=/public/oauth2/1/pull/pulldocument

# ---------------- Voice / microphone ----------------
# Optional. Leave empty to use the Windows default microphone.
AUDIO_DEVICE_INDEX=
VOICE_LISTEN_TIMEOUT=8
VOICE_PHRASE_TIME_LIMIT=15
VOICE_AMBIENT_CALIBRATION=0.6

# ---------------- OCR ----------------
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Install only the Tesseract language packs you need.
# Recommended first set: eng+hin+mar+guj+tam+tel+kan+mal+ben+pan+ori+asm
OCR_LANGUAGES=eng+hin+mar+guj+tam+tel+kan+mal+ben+pan+ori+asm
OCR_DPI=220

# Application behavior
DEFAULT_UI_LANGUAGE=en-IN
LANGUAGE_CACHE_ENABLED=true

# ---------------- Browser / Render ----------------
# Use a long random value that is persistent across deployments; also encrypts stored OAuth tokens.
WEB_APP_SECRET_KEY=
SESSION_COOKIE_SECURE=true
DOCUMENT_FOLDER=/documents
# PostgreSQL for user accounts / timeline / audit history. Render's DATABASE_URL is used by default.
WEB_PORTAL_DATABASE_URL=
# Optional data directory for the desktop index / SQLite portal fallback. Web indexes live under
# DOCUMENT_FOLDER/users/<user_id>/.index, keeping each portal account's text index separate.
SMARTDOCUMENT_DATA_DIR=

# Optional: comma-separated account usernames that can view system-wide audit metadata.
ADMIN_USERNAMES=
